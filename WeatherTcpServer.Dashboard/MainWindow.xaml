<Window x:Class="WeatherTcpServer.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WeatherTcpServer.Dashboard"
        mc:Ignorable="d"
        Title="Weather TCP Server Dashboard" Height="720" Width="1100" MinHeight="600" MinWidth="900">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Weather TCP Server" FontSize="18" FontWeight="SemiBold" />
                        <Border Margin="12,0,0,0" Padding="10,4" CornerRadius="999" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="STOPPED" />
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Text" Value="RUNNING" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Start" Width="120" Margin="0,0,10,0" Command="{Binding StartCommand}" />
                        <Button Content="Stop" Width="120" Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Bind IP" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBox Width="200" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Vertical">
                        <TextBlock Text="Port" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBox Width="120" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Grid.Column="4" Orientation="Vertical">
                        <TextBlock Text="Tip" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                        <TextBlock Text="Send 1 JSON per line (newline-delimited)" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <UniformGrid Columns="2" Rows="2" Margin="0">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="WEATHER" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Environmental" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Device ID: " Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Weather.DeviceId, TargetNullValue=-, FallbackValue=-}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Temperature" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Weather.Temperature, TargetNullValue=00.00, StringFormat={}{0:0.00} °C}" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="DewPoint" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Weather.DewPoint, TargetNullValue=00.00, StringFormat={}{0:0.00} °C}" FontSize="18" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Humidity" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Weather.Humidity, TargetNullValue=00.00, StringFormat={}{0:0.00} %}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Pressure" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Weather.Pressure, TargetNullValue=00.00, StringFormat={}{0:0.00} hPa}" FontSize="18" />
                                    <TextBlock Text="Altitude" Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
                                    <TextBlock Text="{Binding Weather.Altitude, TargetNullValue=00.00, StringFormat={}{0:0.00} m}" FontSize="18" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="HEAT INDEX" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Comfort" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Device ID: " Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Weather.DeviceId, TargetNullValue=-, FallbackValue=-}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="HeatIndex" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding HeatIndex.HeatIndex, TargetNullValue=00.00, StringFormat={}{0:0.00}}" FontSize="36" FontWeight="SemiBold" />

                            <TextBlock Text="ReadingTime" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding HeatIndex.ReadingTime, Converter={StaticResource ReadingTimeConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="HYDRO" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Water" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Device ID: " Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Weather.DeviceId, TargetNullValue=-, FallbackValue=-}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="WaterLevel" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding Hydro.WaterLevel, TargetNullValue=00}" FontSize="36" FontWeight="SemiBold" />

                            <TextBlock Text="ReadingTime" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding Hydro.ReadingTime, Converter={StaticResource ReadingTimeConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="GAS" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Safety" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="•" Foreground="{StaticResource MutedTextBrush}" Margin="10,0" />
                                <TextBlock Text="Device ID: " Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                <TextBlock Text="{Binding Weather.DeviceId, TargetNullValue=-, FallbackValue=-}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="GasDetected" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0" />
                            <TextBlock FontSize="36" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="FALSE" />
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Gas.GasDetected}" Value="True">
                                                <Setter Property="Text" Value="TRUE" />
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="ReadingTime" Foreground="{StaticResource MutedTextBrush}" Margin="0,16,0,0" />
                            <TextBlock Text="{Binding Gas.ReadingTime, Converter={StaticResource ReadingTimeConverter}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Connections / JSON parsing" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Logs}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
